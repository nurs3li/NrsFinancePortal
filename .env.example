# NrsFinancePortal — Docker Compose ortam değişkenleri
# Kullanım: bu dosyayı kopyalayın → `.env` (repo kökünde). `.env` git'e eklenmez.

# --- Zorunlu (PostgreSQL) ---
POSTGRES_DB=nrs_finance
POSTGRES_USER=nrs
POSTGRES_PASSWORD=change-me-local

# --- Keycloak (yerel geliştirme varsayılanları) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Harici API anahtarları (bazı piyasa özellikleri için) ---
# EVDS: enflasyon, faiz, mevduat, eurobond (TCMB). Anahtar: https://evds3.tcmb.gov.tr/
EVDS_API_KEY=
# FinHub: ABD hisse verisi (opsiyonel)
FINHUB_API_KEY=

# --- Portföy AI (opsiyonel; boş bırakılırsa AI analizi devre dışı kalır) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- E-posta bildirimleri (opsiyonel; Gmail OAuth) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_ADDRESS=
NOTIFICATION_TEST_EMAIL=
FINANCE_BASE_URL=http://localhost:8085

# --- Frontend (tarayıcıdan erişilebilir URL'ler; docker compose frontend-dev) ---
VITE_API_URL=http://localhost:8085
VITE_MARKET_API_URL=http://localhost:8083
VITE_NOTIFICATION_API_URL=http://localhost:8089
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=nrs-finance
VITE_KEYCLOAK_CLIENT_ID=nrs-frontend
VITE_API_VERSION=v1

# --- Merkezi log (Kafka → OpenSearch; Log4j2 KafkaLogAppender minimum seviye) ---
# INFO: access [REQUEST] + iş logları OpenSearch'e gider (enterprise varsayılan).
# WARN: yalnızca uyarı/hata (eski davranış).
APP_LOG_KAFKA_MIN_LEVEL=INFO

# --- Güvenlik (2FA zorunluluğu; sunumda açık göstermek için true yapılabilir) ---
KEYCLOAK_SECURITY_OTP_ENFORCEMENT_ENABLED=false
