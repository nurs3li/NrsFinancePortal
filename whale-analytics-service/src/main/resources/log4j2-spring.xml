<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="30" packages="com.nurseli.whaleanalytics.logging">
    <Properties>
        <Property name="LOG_PATTERN">{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%p","service":"${SERVICE_NAME}","correlationId":"%X{correlationId:-}","traceId":"%X{trace_id:-}","spanId":"%X{span_id:-}","thread":"%t","logger":"%c{1.}","message":"%enc{%m}{JSON}"}%n</Property>
        <Property name="SERVICE_NAME">whale-analytics-service</Property>
        <Property name="KAFKA_BOOTSTRAP">${env:KAFKA_BOOTSTRAP_SERVERS:-localhost:9092}</Property>
    </Properties>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="${LOG_PATTERN}"/></Console>
        <KafkaLog name="KafkaLog" topic="application-logs" bootstrapServers="${KAFKA_BOOTSTRAP}" serviceName="${SERVICE_NAME}"/>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="KafkaLog" level="WARN"/>
        </Root>
    </Loggers>
</Configuration>
