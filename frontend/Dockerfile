# Build stage
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY . .
ARG VITE_API_URL=http://localhost:8085
ARG VITE_MARKET_API_URL=http://localhost:8083
ARG VITE_METRICS_URL=http://localhost:8088
ARG VITE_KEYCLOAK_URL=http://localhost:8081
ARG VITE_KEYCLOAK_REALM=nrs-finance
ARG VITE_KEYCLOAK_CLIENT_ID=nrs-finance-backend
ARG VITE_NOTIFICATION_API_URL=
ARG VITE_GRAFANA_SOLO_BASE=
ARG VITE_GRAFANA_ORG_ID=
ARG VITE_GRAFANA_AUDIT_PANEL_REQUEST_VOLUME=
ARG VITE_GRAFANA_AUDIT_PANEL_ERROR_RATE=
ARG VITE_GRAFANA_AUDIT_PANEL_P95_RESPONSE=
ARG VITE_GRAFANA_AUDIT_PANEL_SERVICE_HEALTH=
ARG VITE_GRAFANA_AUDIT_PANEL_TEMPO_SPAN_RATE=
ARG VITE_GRAFANA_AUDIT_PANEL_TEMPO_NODE_GRAPH=
ARG VITE_GRAFANA_TEMPO_EXPLORE_DRILLDOWN_URL=
ARG VITE_GRAFANA_TEMPO_EXPLORE_NODE_GRAPH_URL=
ARG VITE_GRAFANA_SERVICE_MAP_TRACE_URL_TEMPLATE=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_MARKET_API_URL=$VITE_MARKET_API_URL
ENV VITE_METRICS_URL=$VITE_METRICS_URL
ENV VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL
ENV VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM
ENV VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID
ENV VITE_NOTIFICATION_API_URL=$VITE_NOTIFICATION_API_URL
ENV VITE_GRAFANA_SOLO_BASE=$VITE_GRAFANA_SOLO_BASE
ENV VITE_GRAFANA_ORG_ID=$VITE_GRAFANA_ORG_ID
ENV VITE_GRAFANA_AUDIT_PANEL_REQUEST_VOLUME=$VITE_GRAFANA_AUDIT_PANEL_REQUEST_VOLUME
ENV VITE_GRAFANA_AUDIT_PANEL_ERROR_RATE=$VITE_GRAFANA_AUDIT_PANEL_ERROR_RATE
ENV VITE_GRAFANA_AUDIT_PANEL_P95_RESPONSE=$VITE_GRAFANA_AUDIT_PANEL_P95_RESPONSE
ENV VITE_GRAFANA_AUDIT_PANEL_SERVICE_HEALTH=$VITE_GRAFANA_AUDIT_PANEL_SERVICE_HEALTH
ENV VITE_GRAFANA_AUDIT_PANEL_TEMPO_SPAN_RATE=$VITE_GRAFANA_AUDIT_PANEL_TEMPO_SPAN_RATE
ENV VITE_GRAFANA_AUDIT_PANEL_TEMPO_NODE_GRAPH=$VITE_GRAFANA_AUDIT_PANEL_TEMPO_NODE_GRAPH
ENV VITE_GRAFANA_TEMPO_EXPLORE_DRILLDOWN_URL=$VITE_GRAFANA_TEMPO_EXPLORE_DRILLDOWN_URL
ENV VITE_GRAFANA_TEMPO_EXPLORE_NODE_GRAPH_URL=$VITE_GRAFANA_TEMPO_EXPLORE_NODE_GRAPH_URL
ENV VITE_GRAFANA_SERVICE_MAP_TRACE_URL_TEMPLATE=$VITE_GRAFANA_SERVICE_MAP_TRACE_URL_TEMPLATE

# Vite: parent envDir kullanma (container’da .. → / ve .env yükleri belirsizleşir); VITE_* buradan gelir.
ENV DOCKER_BUILD=1

RUN npm run build

# Production stage – nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]